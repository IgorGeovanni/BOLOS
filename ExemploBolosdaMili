        <tr><td class="tam">1,5 kg</td><td>15 pessoas</td><td class="preco">R$ 119,90</td></tr>
        <tr><td class="tam">2 kg</td><td>20 pessoas</td><td class="preco">R$ 149,90</td></tr>
        <tr><td class="tam">3 kg</td><td>30 pessoas</td><td class="preco">R$ 209,90</td></tr>
